{
  "manifest_version": 3,
  "name": "MuseFlow - muse.ai视频生成工作流",
  "version": "0.5.0",
  "description": "muse.ai视频生成工作流，直接使用已登录的 Muse.ai 浏览器会话。",
  "action": {
    "default_title": "打开 MuseFlow 中文版",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://muse.ai/*",
    "https://*.muse.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://muse.ai/*",
        "https://*.muse.ai/*"
      ],
      "js": [
        "muse-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
